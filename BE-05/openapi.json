{
  "openapi": "3.0.0",
  "info": {
    "title": "BE-05 API",
    "version": "1.0.0",
    "description": "Task API secured with Supabase Auth — signup, login, logout, and protected routes."
  },
  "servers": [{ "url": "http://localhost:3000" }],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/auth/signup": {
      "post": {
        "summary": "Create a new user account",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "User created" },
          "400": { "description": "Bad request" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Authenticate and return a JWT",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Access token returned" },
          "400": { "description": "Bad request" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "End the user's session",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "204": { "description": "Logged out" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/public/info": {
      "get": {
        "summary": "Read public, open data",
        "responses": {
          "200": { "description": "Public info" }
        }
      }
    },
    "/protected/profile": {
      "get": {
        "summary": "Read private profile data",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Profile data" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/protected/dashboard": {
      "get": {
        "summary": "Protected dashboard (proves middleware reuse)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Dashboard data" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/tasks": {
      "get": { "summary": "List all tasks", "responses": { "200": { "description": "OK" } } },
      "post": { "summary": "Create a task", "responses": { "201": { "description": "Created" } } }
    },
    "/tasks/{id}": {
      "get": { "summary": "Get a task by ID", "responses": { "200": { "description": "OK" } } },
      "put": { "summary": "Update a task", "responses": { "200": { "description": "OK" } } },
      "delete": { "summary": "Delete a task", "responses": { "200": { "description": "OK" } } }
    }
  }
}